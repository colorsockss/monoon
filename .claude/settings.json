{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./monoon test *)",
      "Bash(dotnet build *)",
      "Bash(engine/scripts/bootstrap-worktree.sh)",
      "Bash(sh engine/scripts/bootstrap-worktree.sh)",
      "Bash(python3 .claude/hooks/test_guard.py)"
    ],
    "deny": [
      "Edit(**/.test-env/**)",
      "Bash(rm *.test-env*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(brew install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(dotnet tool install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
