entry: Idle
states:
- name: Idle
  clip: 47a2ea97-aab3-47ee-b381-8dac6324f9b3
- name: Walk
  clip: 6b5b7aee-9d00-50d6-b4d2-863de8549d94
- name: Attack
  clip: c94effc3-e42e-52b4-bf24-d8a1aced2274
- name: Recover
  clip: ccac995d-949f-580a-b1aa-21c734b93d8a
- name: Hurt
  clip: e26ef60b-3069-54e1-ab24-41a757701410
parameters:
- name: Speed
  kind: Float
  default: 0
- name: Grounded
  kind: Bool
  default: 1
- name: Combo
  kind: Int
  default: 0
- name: Attack
  kind: Trigger
  default: 0
- name: Hit
  kind: Trigger
  default: 0
transitions:
- from: Any State
  to: Hurt
  parameter: Hit
  test: Triggered
- from: Idle
  to: Walk
  parameter: Speed
  test: Greater
  value: 0.1
  and:
  - parameter: Grounded
    test: "True"
- from: Walk
  to: Idle
  parameter: Speed
  test: AtMost
  value: 0.1
- from: Idle
  to: Attack
  parameter: Attack
  test: Triggered
  and:
  - parameter: Combo
    test: Less
    value: 3
- from: Walk
  to: Attack
  parameter: Attack
  test: Triggered
  and:
  - parameter: Combo
    test: Less
    value: 3
- from: Attack
  to: Recover
  parameter: ""
  test: ""
  exitTime: 1
- from: Recover
  to: Idle
  parameter: ""
  test: ""
  exitTime: 1
- from: Hurt
  to: Idle
  parameter: Grounded
  test: "True"
  exitTime: 1
