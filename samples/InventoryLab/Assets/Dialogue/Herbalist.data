version: 1
values:
  format: "monoon.dialogue.v1"
  start: "greeting"
  nodes:
  - id: "greeting"
    speaker: "약초상"
    text: "<b>약초상</b>입니다. 어서 오세요. 무슨 일로 오셨나요?"
    choices:
    - {text: "의뢰를 알아본다", next: "offer", action: ""}
    - {text: "보상을 문의한다", next: "reward", action: ""}
    - {text: "나중에 온다", next: "farewell", action: ""}
    - {text: "약초가 자라는 곳을 묻는다", next: "meadow", action: ""}
  - id: "meadow"
    speaker: "약초상"
    text: "herbalist.meadow"
    choices:
    - {text: "처음으로 돌아간다", next: "greeting", action: ""}
  - id: "offer"
    speaker: "약초상"
    text: "<icon=herb> <color=#9BE27A>새 잎이 돋은 약초</color> <size=24><b>세 포기</b></size>가 필요해요. 모아 주시겠어요?"
    choices:
    - {text: "의뢰를 받는다", next: "accepted", action: "accept"}
    - {text: "이번에는 사양한다", next: "farewell", action: ""}
  - id: "accepted"
    speaker: "약초상"
    text: "고마워요. 약초를 모은 뒤 다시 말을 걸어 주세요."
    choices:
    - {text: "약초를 찾으러 간다", next: "", action: ""}
  - id: "reward"
    speaker: "약초상"
    text: "의뢰를 마쳤다면 수정 한 개를 드릴게요."
    choices:
    - {text: "보상을 받는다", next: "paid", action: "claim"}
    - {text: "처음으로 돌아간다", next: "greeting", action: ""}
  - id: "paid"
    speaker: "약초상"
    text: "여기 약속한 <color=#C9A0FF><b>수정</b></color>이에요. 덕분에 약을 지을 수 있겠어요."
    choices:
    - {text: "대화를 마친다", next: "", action: ""}
  - id: "farewell"
    speaker: "약초상"
    text: "필요한 일이 생기면 또 들르세요."
    choices:
    - {text: "대화를 마친다", next: "", action: ""}
