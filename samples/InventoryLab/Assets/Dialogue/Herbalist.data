version: 1
values:
  format: "monoon.dialogue.v1"
  start: "greeting"
  nodes:
  - id: "greeting"
    speaker: "Herbalist"
    text: "I'm the <b>Herbalist</b>. Welcome. What brings you here?"
    choices:
    - {text: "Ask about the request", next: "offer", action: ""}
    - {text: "Ask about the reward", next: "reward", action: ""}
    - {text: "Come back later", next: "farewell", action: ""}
    - {text: "Ask where the herbs grow", next: "meadow", action: ""}
  - id: "meadow"
    speaker: "Herbalist"
    text: "herbalist.meadow"
    choices:
    - {text: "Back to the start", next: "greeting", action: ""}
  - id: "offer"
    speaker: "Herbalist"
    text: "<icon=herb> I need <size=24><b>three bundles</b></size> of <color=#9BE27A>fresh-leafed herbs</color>. Would you gather them for me?"
    choices:
    - {text: "Accept the request", next: "accepted", action: "accept"}
    - {text: "Decline for now", next: "farewell", action: ""}
  - id: "accepted"
    speaker: "Herbalist"
    text: "Thank you. Talk to me again once you have the herbs."
    choices:
    - {text: "Go look for herbs", next: "", action: ""}
  - id: "reward"
    speaker: "Herbalist"
    text: "Finish the request and I'll give you one crystal."
    choices:
    - {text: "Claim the reward", next: "paid", action: "claim"}
    - {text: "Back to the start", next: "greeting", action: ""}
  - id: "paid"
    speaker: "Herbalist"
    text: "Here is the <color=#C9A0FF><b>crystal</b></color> I promised. Now I can prepare the medicine, thanks to you."
    choices:
    - {text: "End the conversation", next: "", action: ""}
  - id: "farewell"
    speaker: "Herbalist"
    text: "Stop by again whenever you need something."
    choices:
    - {text: "End the conversation", next: "", action: ""}
