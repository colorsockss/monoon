maxParticles: 1024
rate: 260
shape: Edge
width: 760
direction: 95
speed: {min: 260, max: 320}
lifetime: {min: 2, max: 2}
size: {min: 1.5, max: 2}
aspect: 4
rotation: {min: 5, max: 5}
color: {min: "#9FC8FFC0"}
endAlpha: 1
gravity: 300
# Drops bounce off the ground, the hill slopes and the top of the plank, and lose most of their life on each hit.
collision: {mode: Tiles, bounce: 0.35, dampen: 0.3, lifetimeLoss: 0.6}
# Each drop that hits a tile throws 2 splash droplets (the Splash child object; its pool of 256 drops the rest).
subEmitters: [{when: Collision, particles: a2b4b682-4533-4f09-bb1b-9f5ac04d7002, count: 2, inheritVelocity: 0.2}]
