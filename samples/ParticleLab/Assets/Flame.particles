rate: 70
shape: Cone
radius: 18
spread: 30
speed: {min: 50, max: 90}
lifetime: {min: 0.9, max: 1.3}
size: {min: 10, max: 16}
color: {min: "#FFFFFF"}
gravity: -40
blend: Additive
sizeOverLifetime: {keys: [{time: 0, value: 0.6}, {time: 0.2, value: 1}, {time: 1, value: 0.2}]}
# Pale yellow, orange, then dark red; fades in over the first tenth and out over the second half.
colorOverLifetime:
  colors: [{time: 0, color: "#FFF3B0"}, {time: 0.35, color: "#FF9A3C"}, {time: 1, color: "#7A1A10"}]
  alphas: [{time: 0, alpha: 0}, {time: 0.1, alpha: 1}, {time: 0.5, alpha: 0.8}, {time: 1, alpha: 0}]
