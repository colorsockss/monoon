using System;
using System.Globalization;
using System.IO;
using Engine.Core;

// Test-only observer copied into a disposable PlatformerLab. Records the camera centre and each layer's parallax offset every
// game tick: the showcase's sky backing (scroll 0), moon (0.05) and sky picture (0.15).
public sealed class TraceParallax : GameBehaviour
{
    public Guid Camera, Back, Moon, Sky;
    private int frame;

    public override void FixedUpdate(ScriptTick tick)
    {
        if (Environment.GetEnvironmentVariable("MONOON_PARALLAX_TRACE") is not { Length: > 0 } path) return;
        if (!tick.Cameras.TryGetView(Camera, out var view)) throw new InvalidOperationException("No camera view.");
        static string F(float v) => v.ToString("R", CultureInfo.InvariantCulture);
        string line = $"{frame}|tick={tick.Session.Time.TickCount}|camera={F(view.Center.X)},{F(view.Center.Y)}";
        foreach (var (name, id) in new[] { ("back", Back), ("moon", Moon), ("sky", Sky) })
        {
            if (!tick.Cameras.TryGetParallaxOffset(id, out var offset)) throw new InvalidOperationException($"No parallax offset for {name}.");
            line += $"|{name}={F(offset.X)},{F(offset.Y)}";
        }
        File.AppendAllText(path, line + "\n");
        frame++;
    }
}
