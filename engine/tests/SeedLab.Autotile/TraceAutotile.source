using System;
using System.Drawing;
using System.IO;
using System.Text;
using Engine.Core;

// Test-only observer copied into a disposable SeedLab. Edits hedge and decor cells of the route showcase at fixed ticks and
// records the art the engine resolves for every cell of its Hedges and Decor layers, plus the animated ripple and torch frame
// on every tick.
public sealed class TraceAutotile : GameBehaviour
{
    private static readonly Guid Hedges = new("43c40de0-db21-567b-9856-b095d3c351df");
    private static readonly Guid Decor = new("02a615d7-0f9a-5112-974c-f4bbe220b680");
    private static readonly (int Tick, Guid Layer, int X, int Y, int Tile)[] Edits =
    [
        (10, Hedges, 5, 3, 0), (10, Hedges, 6, 4, 1), (10, Hedges, 0, 0, 0), (10, Decor, 4, 2, 0), (10, Decor, 8, 0, 0),
        (30, Hedges, 5, 3, 1), (30, Hedges, 6, 4, 0), (30, Decor, 4, 2, 51), (30, Decor, 8, 0, 61),
    ];

    public override void FixedUpdate(ScriptTick tick)
    {
        if (Environment.GetEnvironmentVariable("MONOON_AUTOTILE_TRACE") is not { Length: > 0 } path) return;
        long now = tick.Session.Time.TickCount;
        foreach (var edit in Edits)
            if (edit.Tick == now && !tick.Objects.SetTile(edit.Layer, new Point(edit.X, edit.Y), edit.Tile))
                throw new InvalidOperationException($"SetTile {edit.X},{edit.Y} failed");
        if (!tick.Objects.TryGetTile(Decor, new Point(8, 2), out var ripple) || !tick.Objects.TryGetTile(Decor, new Point(16, 4), out var torch))
            throw new InvalidOperationException("No decor layer");
        File.AppendAllText(path, $"{now}|clock|{ripple.Display},{torch.Display}\n");
        if (now is not (1 or 20 or 40)) return;
        var line = new StringBuilder();
        foreach (var (name, layer) in new[] { ("hedges", Hedges), ("decor", Decor) })
        {
            line.Append(now).Append('|').Append(name).Append('|');
            for (int y = 0; y < 9; y++)
            for (int x = 0; x < 18; x++)
            {
                if (!tick.Objects.TryGetTile(layer, new Point(x, y), out var info)) throw new InvalidOperationException($"No {name} layer");
                line.Append(info.Tile == 0 ? 0 : info.Display).Append(x == 17 && y == 8 ? '\n' : ',');
            }
        }
        File.AppendAllText(path, line.ToString());
    }
}
