using System;
using System.Globalization;
using System.IO;
using Engine.Core;

// Test-only observer copied into a disposable CameraLab. One line per game tick: both walkers' positions and each camera
// (centre, zoom), "-" for a camera that is switched off (the framing showcase runs one of its two cameras at a time).
public sealed class TraceCameras : GameBehaviour
{
    public Guid Main, Second, Player, Partner;

    public override void FixedUpdate(ScriptTick tick)
    {
        if (Environment.GetEnvironmentVariable("MONOON_CAMERA_TRACE") is not { Length: > 0 } path) return;
        if (!tick.Objects.TryGetPosition(Player, out var p) || !tick.Objects.TryGetPosition(Partner, out var q)) return;
        static string F(float v) => v.ToString("R", CultureInfo.InvariantCulture);
        string View(Guid id) => tick.Cameras.TryGetView(id, out var v) ? $"{F(v.Center.X)},{F(v.Center.Y)},{F(v.Zoom)}" : "-";
        File.AppendAllText(path, $"{tick.Session.Time.TickCount}|{F(p.X)},{F(p.Y)}|{F(q.X)},{F(q.Y)}|{View(Main)}|{View(Second)}\n");
    }
}
