using System;
using System.Globalization;
using System.IO;
using System.Numerics;
using Engine.Core;

// Attached to the route's Field only in the test copy, after DriveRoute. Observes the courier's transform and the inputs
// independently of the planner.
public sealed class TraceCourier : GameBehaviour
{
    public Guid Courier;
    private Vector2? previous;

    public override void FixedUpdate(ScriptTick tick)
    {
        string path = Environment.GetEnvironmentVariable("MONOON_ROUTE_TRACE");
        if (string.IsNullOrEmpty(path) || !tick.Objects.TryGetLocalTransform(Courier, out var local)) return;
        string action = tick.Input.Pressed("Rebuild") ? "reset" : tick.Input.Pressed("ToggleGate") ? "bridge" :
            tick.Input.Pressed("RouteDirections") ? "directions" : tick.Input.Pressed("PaintMud") ? "rain" : "-";
        if (previous == local.Position && action == "-") return;
        previous = local.Position;
        File.AppendAllText(path, string.Create(CultureInfo.InvariantCulture, $"{action} {local.Position.X} {local.Position.Y}\n"));
    }
}
