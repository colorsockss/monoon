using System;
using System.Globalization;
using System.IO;
using Engine.Core;

// Attached to the Runner only in the disposable test project. Each row observes the preceding physics step: the capsule
// runner (x y) and whether it stands on something.
public sealed class ColliderTrace : GameBehaviour
{
    private int frame;
    public override void FixedUpdate(ScriptTick tick)
    {
        var path = Environment.GetEnvironmentVariable("MONOON_COLLIDER_TRACE");
        if (string.IsNullOrEmpty(path)) return;
        tick.Objects.Motion.TryGetMotion(tick.ObjectId, out var body);
        File.AppendAllText(path, string.Create(CultureInfo.InvariantCulture,
            $"{frame++} {tick.Position.X:F4} {tick.Position.Y:F4} {(body.Grounded ? 1 : 0)}\n"));
    }
}
