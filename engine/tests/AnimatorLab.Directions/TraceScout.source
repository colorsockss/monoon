using System;
using System.IO;
using Engine.Core;

// Test-only observer added to the Scout in a disposable AnimatorLab. Runs after ScoutDemo on the same object, so each line
// is the animator state, frame and facing before this tick's animator step.
public sealed class TraceScout : GameBehaviour
{
    private int tick;

    public override void FixedUpdate(ScriptTick step)
    {
        if (Environment.GetEnvironmentVariable("MONOON_SCOUT_TRACE") is not { Length: > 0 } path) return;
        var animator = step.Objects.Animator(step.ObjectId)!;
        File.AppendAllText(path, $"{tick++}|{animator.State}|{animator.Frame}|{animator.Facing}\n");
    }
}
