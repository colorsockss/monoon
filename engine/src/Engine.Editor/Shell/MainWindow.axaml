<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Engine.Editor"
        x:Class="Engine.Editor.MainWindow" Title="MoNoon"
        Width="1220" Height="740" MinWidth="760" MinHeight="440">
  <Window.Icon>
    <OnPlatform x:TypeArguments="WindowIcon" Default="/Assets/MoNoon.png" macOS="/Assets/MoNoon.macOS.png"/>
  </Window.Icon>
  <Window.Resources>
    <ControlTheme x:Key="DrawerHeader" TargetType="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="{TemplateBinding Content}"/>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource EditorHover}"/></Style>
      <Style Selector="^:focus-visible"><Setter Property="Background" Value="{DynamicResource EditorActive}"/></Style>
    </ControlTheme>
    <!-- 16px check for the object's active state and component headers: fits the reserved header column. -->
    <ControlTheme x:Key="CompactCheck" TargetType="CheckBox">
      <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
      <Setter Property="Background" Value="{DynamicResource EditorField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="box" Width="14" Height="14" CornerRadius="2" BorderThickness="1" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Name="mark" Data="M2.5,6.5 L5.2,9.2 L10.5,3.5" Stroke="{DynamicResource EditorOnAccent}" StrokeThickness="1.6" IsVisible="False"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource EditorBorderHover}"/></Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource EditorAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource EditorAccent}"/>
      </Style>
      <Style Selector="^:checked /template/ Path#mark"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^:focus-visible /template/ Border#box"><Setter Property="BorderBrush" Value="{DynamicResource EditorAccentHover}"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:ComponentSection}" TargetType="local:ComponentSection">
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource EditorDivider}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" MinHeight="{StaticResource EditorRowHeight}">
                <!-- Prefab override dot (13.6), in the panel padding like the row bars: the header text never moves. -->
                <Ellipse Name="OverrideDot" Width="5" Height="5" Margin="-7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource EditorAccent}" IsHitTestVisible="False" IsVisible="{TemplateBinding IsOverridden}"
                         ToolTip.Tip="Prefab override"/>
                <ToggleButton Name="HeaderToggle" Classes="drawerHeader" Theme="{StaticResource DrawerHeader}" MinHeight="{StaticResource EditorRowHeight}" Padding="0"
                              IsChecked="{Binding Foldout.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip.Tip="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                  <!-- The third column is reserved in every section for the on/off check, so titles share one x. -->
                  <Grid ColumnDefinitions="8,16,16,*" ColumnSpacing="4">
                    <PathIcon Width="7" Height="7" Data="M1,0 L7,4 L1,8 Z"/>
                    <PathIcon Grid.Column="1" Theme="{StaticResource EditorIcon}" Foreground="{DynamicResource EditorMuted}"
                              Data="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                </ToggleButton>
                <!-- Above the fold toggle (not inside it): a click turns the component on or off without folding it. -->
                <CheckBox Name="EnabledCheck" Theme="{StaticResource CompactCheck}" MinHeight="0" Margin="32,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          IsVisible="{TemplateBinding CanToggle}"
                          IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} enabled'}"
                          ToolTip.Tip="Enabled: a turned-off component is left out of Play and builds"/>
                <Button Grid.Column="1" IsVisible="{TemplateBinding HasSettings}" Classes="quiet" Padding="2" Width="20" Height="20" MinHeight="0" Background="Transparent"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Component settings"
                        AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} settings'}"
                        Click="ComponentSettingsClick">
                  <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconGear}"/>
                </Button>
              </Grid>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Padding="0,2,0,4"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding IsChecked, ElementName=HeaderToggle, TargetNullValue=False}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="ProjectListItem">
      <Grid ColumnDefinitions="16,*" ColumnSpacing="4" ToolTip.Tip="{Binding RelativePath}">
        <PathIcon Theme="{StaticResource EditorIcon}" Foreground="{DynamicResource EditorMuted}" Data="{Binding Icon}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
          <TextBlock IsVisible="{Binding SearchResult}" Classes="label" Text="{Binding Directory}" TextTrimming="LeadingCharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- Grid tile: a PNG shows its pixels, anything else its type icon; the name trims under it. -->
    <DataTemplate x:Key="ProjectGridItem">
      <StackPanel Spacing="2" ToolTip.Tip="{Binding RelativePath}">
        <Panel Width="48" Height="48" HorizontalAlignment="Center">
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
          <PathIcon Theme="{StaticResource EditorIcon}" Width="32" Height="32" HorizontalAlignment="Center" Foreground="{DynamicResource EditorMuted}"
                    Data="{Binding Icon}" IsVisible="{Binding !HasThumbnail}"/>
        </Panel>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Window.DataTemplates>
    <DataTemplate DataType="local:SpriteFields">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="56,*" ColumnSpacing="{StaticResource EditorFieldGap}">
          <TextBlock Classes="fieldLabel" Text="Sprite"/>
          <ContentControl Grid.Column="1" Content="{Binding SpriteEditor}"/>
        </Grid>
        <ContentControl Content="{Binding DrawEditor}"/>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource EditorFieldGap}" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Layer"/>
          <NumericUpDown Grid.Column="1" Minimum="-32768" Maximum="32767" Increment="1" Value="{Binding Layer, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Order"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-32768" Maximum="32767" Increment="1" Value="{Binding Order, Mode=TwoWay}"/>
        </Grid>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource EditorFieldGap}" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Y sort"/>
          <CheckBox Grid.Column="1" Content="Use foot Y" IsChecked="{Binding SortByY, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Foot ΔY"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-1000000" Maximum="1000000" Increment="1"
                         IsEnabled="{Binding SortByY}" Value="{Binding FootOffset, Mode=TwoWay}"
                         ToolTip.Tip="Local Y offset from the bottom center, in world units."/>
        </Grid>
        <Grid ColumnDefinitions="56,*" ColumnSpacing="{StaticResource EditorFieldGap}">
          <TextBlock Text="Color" Classes="fieldLabel"/>
          <ContentControl Grid.Column="1" Content="{Binding ColorEditor}"/>
        </Grid>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource EditorFieldGap}" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Flip"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <CheckBox Content="X" IsChecked="{Binding FlipX, Mode=TwoWay}" AutomationProperties.Name="Flip X"/>
            <CheckBox Content="Y" IsChecked="{Binding FlipY, Mode=TwoWay}" AutomationProperties.Name="Flip Y"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Align"/>
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Pixel snap" IsChecked="{Binding PixelSnap, Mode=TwoWay}"/>
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Mask"/>
          <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding MaskEditor}"/>
        </Grid>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <Window.Styles>
    <StyleInclude Source="avares://MoNoon/PanelStyles.axaml"/>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,21">
    <NativeMenuBar/>
    <!-- Play starts at the centre line; the Play-time options sit just left of it and never move it. -->
    <Border Grid.Row="1" x:Name="MainToolbar" Classes="mainToolbar">
      <Grid ColumnDefinitions="*,*">
        <StackPanel x:Name="TimeControls" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False">
          <ToggleButton x:Name="DebugButton" Height="21" MinHeight="0" Padding="5,0" Content="Debug" AutomationProperties.Name="Play diagnostics" ToolTip.Tip="Show runtime diagnostics below the game view"/>
          <ComboBox x:Name="SpeedPicker" Width="68" Height="21" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center"
                    ToolTip.Tip="Game speed" AutomationProperties.Name="Game speed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="PlayButton" Classes="primary" Width="60" Height="21" MinHeight="0" Padding="4,0" Content="▶  Play" VerticalAlignment="Center"/>
          <Button x:Name="PauseButton" Focusable="False" Width="24" Height="21" MinHeight="0" Padding="0" HorizontalContentAlignment="Center" IsEnabled="False"
                  ToolTip.Tip="Pause or resume game time" AutomationProperties.Name="Pause">
            <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconPause}"/>
          </Button>
          <Button x:Name="StepButton" Focusable="False" Width="24" Height="21" MinHeight="0" Padding="0" HorizontalContentAlignment="Center" IsEnabled="False"
                  ToolTip.Tip="Advance one fixed tick" AutomationProperties.Name="Step">
            <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconStep}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <local:DockHost x:Name="Dock" Grid.Row="2">
      <Grid local:DockHost.Panel="Hierarchy" MinWidth="140" MinHeight="80" RowDefinitions="Auto,*" Background="{DynamicResource EditorPanel}">
          <Border Classes="panelHeader">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBox x:Name="HierarchySearch" Classes="toolbarSearch" Watermark="Search…" AutomationProperties.Name="Search hierarchy"
                       ToolTip.Tip="Show objects whose name contains this text, with their parents. Esc clears.">
                <TextBox.InnerLeftContent><PathIcon Theme="{StaticResource EditorIcon}" Margin="6,0,0,0" Foreground="{DynamicResource EditorMuted}" Data="{StaticResource IconSearch}"/></TextBox.InnerLeftContent>
              </TextBox>
              <Button Classes="panelAction quiet" x:Name="AddButton" Grid.Column="1" AutomationProperties.Name="Add object" ToolTip.Tip="Add square sprite" VerticalAlignment="Center">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconAdd}"/>
              </Button>
            </Grid>
          </Border>
          <ListBox x:Name="Hierarchy" Grid.Row="1" Margin="4,3,4,6" Background="Transparent" AutoScrollToSelectedItem="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Scene objects" ToolTip.Tip="Right-click to add an object. Drag onto a parent or onto empty space for the scene root.">
            <ListBox.Styles>
              <!-- The TreeView row box these rows replaced: 22px tall, square, with a clear 1px border.
                   HierarchyItem adds the indent and chevron. -->
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="22"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForeground}"/>
              </Style>
              <Style Selector="ListBoxItem.groupSelected, ListBoxItem.dropTarget"><Setter Property="Foreground" Value="{DynamicResource EditorAccent}"/></Style>
            </ListBox.Styles>
          </ListBox>
          <TextBlock x:Name="HierarchyNoMatch" Grid.Row="1" Classes="label" Margin="10,8" IsHitTestVisible="False" VerticalAlignment="Top" IsVisible="False" Text="No matching objects"/>
      </Grid>
      <Grid local:DockHost.Panel="Project" x:Name="ProjectPanel" MinWidth="140" MinHeight="100" RowDefinitions="Auto,Auto,*" Background="{DynamicResource EditorPanel}">
          <Border Classes="panelHeader">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
              <TextBox x:Name="AssetSearch" Classes="toolbarSearch" Watermark="Search…" AutomationProperties.Name="Search project" ToolTip.Tip="Search all assets and scripts by path, or type (e.g. t:sprite). Esc clears.">
                <TextBox.InnerLeftContent><PathIcon Theme="{StaticResource EditorIcon}" Margin="6,0,0,0" Foreground="{DynamicResource EditorMuted}" Data="{StaticResource IconSearch}"/></TextBox.InnerLeftContent>
              </TextBox>
              <ToggleButton Grid.Column="1" Classes="panelAction" x:Name="ProjectViewToggle" AutomationProperties.Name="Thumbnail grid" ToolTip.Tip="Show thumbnails in a grid">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconViewGrid}"/>
              </ToggleButton>
              <Button Grid.Column="2" Classes="panelAction quiet" x:Name="ProjectActions" AutomationProperties.Name="Project actions" ToolTip.Tip="Create or import" VerticalAlignment="Center">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconAdd}"/>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem x:Name="ImportAssetsButton" Header="Import Assets…"/>
                    <MenuItem x:Name="ReferencesButton" Header="Asset References…"/>
                    <MenuItem x:Name="ProblemsButton" Header="Check Missing References…"/>
                    <Separator/>
                    <MenuItem x:Name="NewScriptButton" Header="New C# Script…"/>
                    <MenuItem x:Name="NewSharedButton" Header="New Shared C# File…"/>
                    <MenuItem x:Name="NewDataButton" Header="New Data Asset…"/>
                    <MenuItem x:Name="NewDialogueButton" Header="New Dialogue…"/>
                    <MenuItem x:Name="NewTableButton" Header="New Data Table…"/>
                    <MenuItem x:Name="NewTilesetButton" Header="New Tileset…"/>
                    <MenuItem x:Name="NewAtlasButton" Header="New Sprite Atlas…"/>
                    <MenuItem x:Name="NewAnimatorButton" Header="New Animator Controller…"/>
                    <MenuItem x:Name="NewClipButton" Header="New Animation Clip…"/>
                    <MenuItem x:Name="NewSceneButton" Header="New Scene"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <!-- Path bar: the up arrow (also a drop target for moving files up) and one button per folder of the current path. -->
          <Border Grid.Row="1" Classes="pathBar">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
              <Button Classes="crumbIcon quiet" x:Name="ParentFolderButton" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconArrowUp}"/>
              </Button>
              <ScrollViewer Grid.Column="1" x:Name="ProjectPathScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ProjectPath" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Folder path"/>
              </ScrollViewer>
              <TextBlock Grid.Column="1" x:Name="ProjectName" Classes="label" VerticalAlignment="Center" Margin="4,0" TextTrimming="LeadingCharacterEllipsis"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <!-- The folder tree appears once the panel is wide enough to keep the file area usable. -->
            <Border x:Name="FolderTreePane" Width="150" IsVisible="False" BorderBrush="{DynamicResource EditorDivider}" BorderThickness="0,0,1,0">
              <TreeView x:Name="FolderTree" Margin="2,3,2,6" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="Project folders">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                    <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="0"/>
                  </Style>
                  <Style Selector="TreeViewItem"><Setter Property="Padding" Value="3,0"/></Style>
                </TreeView.Styles>
              </TreeView>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
              <ListBox x:Name="ProjectBrowser" Margin="4,3" AutomationProperties.Name="Project files" SelectionMode="Multiple"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ProjectListItem}"/>
              <Border Grid.Row="1" x:Name="ProjectPreviewPanel" IsVisible="False" BorderBrush="{DynamicResource EditorDivider}"
                      BorderThickness="0,1,0,0" Padding="6,4">
                <Image x:Name="ProjectPreview" Height="64" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"
                       AutomationProperties.Name="Selected PNG preview"/>
              </Border>
              <TextBlock x:Name="EmptyFolder" Classes="label" Margin="10,8" IsHitTestVisible="False" VerticalAlignment="Top" Text="Empty folder"/>
            </Grid>
          </Grid>
        </Grid>
      <Grid local:DockHost.Panel="Scene" local:DockHost.Fill="True" MinWidth="240" MinHeight="160" RowDefinitions="Auto,*">
        <Border Classes="panelHeader">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <StackPanel x:Name="GizmoControls" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ToggleButton x:Name="MoveTool" Classes="tool" ToolTip.Tip="Move (W)" AutomationProperties.Name="Move tool">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconMove}"/>
              </ToggleButton>
              <ToggleButton x:Name="RotateTool" Classes="tool" ToolTip.Tip="Rotate (E)" AutomationProperties.Name="Rotate tool">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconRotate}"/>
              </ToggleButton>
              <ToggleButton x:Name="ScaleTool" Classes="tool" ToolTip.Tip="Scale (R)" AutomationProperties.Name="Scale tool">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconScale}"/>
              </ToggleButton>
              <ToggleButton x:Name="RectTool" Classes="tool" ToolTip.Tip="Rect: drag the handles to change Width and Height (T)" AutomationProperties.Name="Rect tool">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconRect}"/>
              </ToggleButton>
              <Border Classes="toolDivider"/>
              <ToggleButton x:Name="GizmoSnap" Classes="tool" ToolTip.Tip="Snap · 16 units · 15° · 10%" AutomationProperties.Name="Snap">
                <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconSnap}"/>
              </ToggleButton>
            </StackPanel>
            <TextBlock x:Name="SceneCaption" Grid.Column="1" Classes="panel" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </Grid>
        </Border>
        <!-- One SDL view: it sits here while editing and moves to the Game panel during Play. -->
        <Decorator x:Name="SceneHost" Grid.Row="1">
          <local:SceneViewport x:Name="Viewport" AutomationProperties.Name="Scene viewport"
                               AutomationProperties.HelpText="Shift-click to toggle selection. W, E, R, T change the transform tool. Drag empty space to pan."/>
        </Decorator>
        <TextBlock x:Name="SceneAway" Grid.Row="1" Classes="label" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="16" Text="The game is running in the Game tab. Stop to edit the scene."/>
      </Grid>
      <Grid local:DockHost.Panel="Game" MinWidth="240" MinHeight="160" RowDefinitions="Auto,*,Auto" Background="{DynamicResource EditorPanel}">
        <Border Classes="panelHeader">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <ComboBox x:Name="GameResolution" Width="104" Height="21" MinHeight="0" Padding="4,0" VerticalAlignment="Center"
                      AutomationProperties.Name="Game resolution" ToolTip.Tip="Project game resolution · applies on the next Play"/>
            <ComboBox x:Name="GameScale" Grid.Column="1" Width="58" Height="21" MinHeight="0" Padding="4,0" VerticalAlignment="Center"
                      AutomationProperties.Name="Game scale" ToolTip.Tip="Fit the panel, or draw each game pixel at a fixed size"/>
            <TextBlock x:Name="GameStats" Grid.Column="2" Classes="label" IsVisible="False" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Game statistics" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <ToggleButton x:Name="StatsButton" Grid.Column="3" Height="21" MinHeight="0" Padding="6,0" Content="Stats" VerticalAlignment="Center"
                          AutomationProperties.Name="Game statistics toggle" ToolTip.Tip="Frame time and SDL draw calls"/>
          </Grid>
        </Border>
        <Decorator x:Name="GameHost" Grid.Row="1"/>
        <TextBlock x:Name="GameIdle" Grid.Row="1" Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="16" Text="Press Play to run the game here."/>
        <StackPanel Grid.Row="2" x:Name="DiagnosticsDock" IsVisible="False" Margin="8,3" Spacing="3">
          <WrapPanel x:Name="DiagnosticsTools" Orientation="Horizontal">
            <CheckBox Margin="0,0,8,0" x:Name="ColliderDebug" Content="Colliders" AutomationProperties.Name="Collider outlines"/>
            <CheckBox Margin="0,0,8,0" x:Name="QueryDebug" Content="Queries" AutomationProperties.Name="Physics queries"/>
            <Button Margin="0,0,8,0" x:Name="ProbeRay" Classes="quiet" Content="Cast ray…" AutomationProperties.Name="Cast ray from selection" ToolTip.Tip="From selected object to next click in Scene"/>
            <CheckBox Margin="0,0,8,0" x:Name="FrameDebug" Content="Profiler" AutomationProperties.Name="Frame profiler"/>
            <Button x:Name="ConsoleDebug" Classes="quiet" Content="Console…" AutomationProperties.Name="Open console"/>
          </WrapPanel>
          <Grid x:Name="RoleQueryRow" IsVisible="False" ColumnDefinitions="Auto,*,*" ColumnSpacing="5">
            <ComboBox x:Name="RoleKindPicker" SelectedIndex="0" AutomationProperties.Name="Object query type">
              <ComboBoxItem Content="Group"/><ComboBoxItem Content="Tag"/>
            </ComboBox>
            <TextBox x:Name="RoleQuery" Grid.Column="1" Watermark="Exact name" AutomationProperties.Name="Object query name"/>
            <TextBlock x:Name="RoleMatches" Grid.Column="2" Classes="fieldLabel" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Matching objects"/>
          </Grid>
          <TextBlock x:Name="PhysicsCaption" Classes="label" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
      <Grid local:DockHost.Panel="Profiler" MinWidth="240" MinHeight="120" Background="{DynamicResource EditorPanel}">
        <Grid x:Name="FramePanel" Margin="8,4" RowDefinitions="Auto,38,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="3">
          <TextBlock x:Name="FrameSummary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="CloseProfiler" Classes="quiet icon" ToolTip.Tip="Close profiler" AutomationProperties.Name="Close profiler">
            <PathIcon Theme="{StaticResource EditorIcon}" Data="{StaticResource IconClose}"/>
          </Button>
          <local:FrameChart Grid.Row="1" Grid.ColumnSpan="2" x:Name="FrameGraph" ToolTip.Tip="Last 180 presented frames · line: frame time · guide: 16.7 ms · gold: GC · click to select a frame"/>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="FrameDetail" Classes="label" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="WorkTitle" TextTrimming="CharacterEllipsis"/>
          <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,64,72,72" Margin="0,0,14,0">
            <TextBlock Text="Work" Classes="label"/>
            <TextBlock Grid.Column="1" Text="Calls" Classes="label" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="Total ms" Classes="label" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="Self ms" Classes="label" HorizontalAlignment="Right"/>
          </Grid>
          <ScrollViewer Grid.Row="5" Grid.ColumnSpan="2" x:Name="WorkScroll" VerticalScrollBarVisibility="Auto" AllowAutoHide="True" AutomationProperties.Name="Selected frame work">
            <StackPanel x:Name="WorkRows" Margin="0,0,14,0"/>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Border x:Name="InspectorPanel" local:DockHost.Panel="Inspector" MinWidth="218" MinHeight="120" Background="{DynamicResource EditorPanel}">
        <Grid RowDefinitions="Auto,*">
          <!-- The tab names the panel; this slim row appears only for selection actions (multi-selection count, Play Apply, prefab overrides). -->
          <Border x:Name="InspectorActions" Classes="panelHeader" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBlock x:Name="InspectorCaption" Classes="label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <!-- 13.11: Apply all sits left of Apply selected in the same cell, so Overrides… (edit mode) keeps its place. -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="ApplyAllPlayValues" Classes="quiet" Content="Apply all" IsVisible="False"
                        Height="21" MinHeight="0" Padding="5,0" Click="ApplyAllPlayValuesClick"
                        ToolTip.Tip="Apply every value edited in this Play session, checked or not, on every object, in one Undo step."/>
                <Button x:Name="ApplyPlayValues" Classes="quiet" Content="Apply selected" IsVisible="False"
                        Height="21" MinHeight="0" Padding="5,0" Click="ApplySelectedPlayValues"
                        ToolTip.Tip="Apply checked fields to the edited scene in one Undo step. A previously saved, clean scene is saved immediately."/>
              </StackPanel>
              <Button x:Name="OverridesButton" Grid.Column="1" Classes="quiet" Content="Overrides…" IsVisible="False"
                      Height="21" MinHeight="0" Padding="5,0" ToolTip.Tip="Inspect prefab property overrides"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="{StaticResource EditorPanelPadding}">
              <TextBlock x:Name="EmptyInspector" Classes="label" Text="Select an object in the scene." TextWrapping="Wrap"/>
              <StackPanel x:Name="MultiInspector" IsVisible="False"/>
              <!-- 13.16: the Project asset clicked last (a summary, import settings and a button for its editor panel). -->
              <StackPanel x:Name="AssetInspector" IsVisible="False"/>
              <StackPanel x:Name="Inspector">
                <TextBlock x:Name="SceneWarning" Classes="componentWarning" IsVisible="False" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="56,*" ColumnSpacing="{StaticResource EditorFieldGap}" Margin="0,0,0,4">
                  <!-- The label keeps the shared left edge; the active check sits at the label column's right end. -->
                  <TextBlock Text="Name" Classes="fieldLabel"/>
                  <CheckBox x:Name="ObjectActive" Theme="{StaticResource CompactCheck}" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.Name="Object active"
                            ToolTip.Tip="Active: an inactive object and its children start disabled in Play and builds (scripts can SetActive them)"/>
                  <TextBox Grid.Column="1" x:Name="ObjectName" AutomationProperties.Name="Object name"/>
                </Grid>
                <local:ComponentSection x:Name="LiveSection" Header="Runtime" HasSettings="False" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="LiveSummary" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ScriptValues" Classes="label" TextWrapping="Wrap"/>
                  </StackPanel>
                </local:ComponentSection>
                <local:ComponentSection x:Name="TransformSection" Header="Transform" Icon="{StaticResource IconTransform}" HasSettings="False">
                  <StackPanel Spacing="2">
                    <StackPanel x:Name="LiveTransform" IsVisible="False" Spacing="2"/>
                    <Grid x:Name="PositionRow" ColumnDefinitions="56,*,*" ColumnSpacing="{StaticResource EditorFieldGap}">
                      <TextBlock x:Name="PositionRowLabel" Text="Position" Classes="fieldLabel"/>
                      <Grid Grid.Column="1" ColumnDefinitions="12,*" ColumnSpacing="2">
                        <TextBlock Text="X" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="PosX" AutomationProperties.Name="Position X"/>
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="12,*" ColumnSpacing="2">
                        <TextBlock Text="Y" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="PosY" AutomationProperties.Name="Position Y"/>
                      </Grid>
                    </Grid>
                    <Grid x:Name="SizeRow" ColumnDefinitions="56,*,*" ColumnSpacing="{StaticResource EditorFieldGap}">
                      <TextBlock Text="Size" Classes="fieldLabel"/>
                      <Grid Grid.Column="1" ColumnDefinitions="12,*" ColumnSpacing="2">
                        <TextBlock Text="W" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="ObjWidth" Minimum="1" AutomationProperties.Name="Width"/>
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="12,*" ColumnSpacing="2">
                        <TextBlock Text="H" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="ObjHeight" Minimum="1" AutomationProperties.Name="Height"/>
                      </Grid>
                    </Grid>
                    <StackPanel x:Name="AffineRows" Spacing="2">
                      <Grid x:Name="RotationRow" ColumnDefinitions="56,*,*" ColumnSpacing="{StaticResource EditorFieldGap}">
                        <TextBlock Text="Rotation" Classes="fieldLabel" ToolTip.Tip="Clockwise degrees in parent space"/>
                        <NumericUpDown Grid.Column="1" Grid.ColumnSpan="2" x:Name="ObjRotation" AutomationProperties.Name="Rotation degrees"/>
                      </Grid>
                      <Grid x:Name="ScaleRow" ColumnDefinitions="56,*,*" ColumnSpacing="{StaticResource EditorFieldGap}">
                        <TextBlock Text="Scale" Classes="fieldLabel"/>
                        <Grid Grid.Column="1" ColumnDefinitions="12,*" ColumnSpacing="2">
                          <TextBlock Text="X" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjScaleX" Increment="0.1" AutomationProperties.Name="Scale X"/>
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="12,*" ColumnSpacing="2">
                          <TextBlock Text="Y" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjScaleY" Increment="0.1" AutomationProperties.Name="Scale Y"/>
                        </Grid>
                      </Grid>
                      <Grid ColumnDefinitions="56,*,*" ColumnSpacing="{StaticResource EditorFieldGap}">
                        <TextBlock Text="Pivot" Classes="fieldLabel"/>
                        <Grid Grid.Column="1" ColumnDefinitions="12,*" ColumnSpacing="2">
                          <TextBlock Text="X" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjPivotX" Increment="0.1" Minimum="0" Maximum="1" AutomationProperties.Name="Pivot X"/>
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="12,*" ColumnSpacing="2">
                          <TextBlock Text="Y" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjPivotY" Increment="0.1" Minimum="0" Maximum="1" AutomationProperties.Name="Pivot Y"/>
                        </Grid>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </local:ComponentSection>
                <local:ComponentSection x:Name="RoleSection" Header="Tags &amp; groups" HasSettings="False">
                  <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="{StaticResource EditorFieldGap}">
                    <TextBlock Text="Tag" Classes="fieldLabel"/>
                    <TextBox Grid.Column="1" x:Name="ObjectTag" AutomationProperties.Name="Object tag"/>
                    <TextBlock Grid.Row="1" Text="Groups" Classes="fieldLabel"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ObjectGroups" AutomationProperties.Name="Object groups"
                             ToolTip.Tip="Separate group names with commas."/>
                  </Grid>
                </local:ComponentSection>
                <local:ComponentSection x:Name="DebugSection" Header="Object (Debug)" Icon="{StaticResource IconInfo}" HasSettings="False" IsVisible="False">
                  <StackPanel x:Name="DebugObjectRows" Spacing="2"/>
                </local:ComponentSection>
                <ItemsControl x:Name="AttachedComponents">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Classes="componentWarning" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding Warning}"/>
                        <local:ComponentSection Header="{Binding Name}" Icon="{Binding Icon}" HasSettings="{Binding Editable}" Foldout="{Binding Foldout}"
                                                CanToggle="{Binding CanToggle}" IsOn="{Binding Enabled, Mode=TwoWay}" IsOverridden="{Binding Overridden}">
                          <ContentControl Content="{Binding Fields}" IsEnabled="{Binding FieldsEnabled}" HorizontalContentAlignment="Stretch"/>
                        </local:ComponentSection>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddComponentButton" Content="+  Add Component" AutomationProperties.Name="Add Component"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </local:DockHost>
    <Border Grid.Row="3" Background="{DynamicResource EditorBase}" BorderBrush="{DynamicResource EditorDivider}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="Status" Classes="label" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="ResolutionLabel" Classes="label" Grid.Column="1" ToolTip.Tip="Game resolution · Project → Game Resolution…"/>
      </Grid>
    </Border>
  </Grid>
</Window>
