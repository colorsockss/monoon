<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Engine.Editor"
        x:Class="Engine.Editor.MainWindow" Title="MoNoon"
        Width="1220" Height="740" MinWidth="760" MinHeight="440">
  <Window.Icon>
    <OnPlatform x:TypeArguments="WindowIcon" Default="/Assets/MoNoon.png" macOS="/Assets/MoNoon.macOS.png"/>
  </Window.Icon>
  <Window.Resources>
    <ControlTheme x:Key="DrawerHeader" TargetType="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="{TemplateBinding Content}"/>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="#2C3138"/></Style>
      <Style Selector="^:focus-visible"><Setter Property="Background" Value="#353E49"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:ComponentSection}" TargetType="local:ComponentSection">
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource EditorDivider}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5" MinHeight="21">
                <ToggleButton Name="HeaderToggle" Classes="drawerHeader" Theme="{StaticResource DrawerHeader}" MinHeight="21" Padding="0"
                              IsChecked="{Binding Foldout.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip.Tip="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                  <Grid ColumnDefinitions="8,*" ColumnSpacing="5">
                    <PathIcon Width="7" Height="7" Data="M1,0 L7,4 L1,8 Z"/>
                    <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                </ToggleButton>
                <Button Grid.Column="1" IsVisible="{TemplateBinding HasSettings}" Classes="quiet" Padding="2" Width="18" Height="18" MinHeight="0" Background="Transparent"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Component settings"
                        AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} settings'}"
                        Click="ComponentSettingsClick">
                  <PathIcon Width="12" Height="12" Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.54,9.37 L19.54,5.91 L17.05,6.91 C16.54,6.52 15.98,6.19 15.37,5.94 L15,3.27 H11 L10.61,5.94 C10.01,6.19 9.44,6.52 8.93,6.91 L6.45,5.91 L4.45,9.37 L6.57,11.02 C6.52,11.34 6.5,11.67 6.5,12 C6.5,12.33 6.52,12.66 6.57,12.98 L4.45,14.63 L6.45,18.09 L8.93,17.09 C9.44,17.48 10.01,17.81 10.61,18.06 L11,20.73 H15 L15.37,18.06 C15.98,17.81 16.54,17.48 17.05,17.09 L19.54,18.09 L21.54,14.63 Z M13,9 A3,3 0 1 1 13,15 A3,3 0 1 1 13,9 Z"/>
                </Button>
              </Grid>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Padding="0,2,0,4"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding IsChecked, ElementName=HeaderToggle, TargetNullValue=False}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>
  <Window.DataTemplates>
    <DataTemplate DataType="local:SpriteFields">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="56,*" ColumnSpacing="5">
          <TextBlock Classes="fieldLabel" Text="Sprite"/>
          <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Select sprite" ToolTip.Tip="Drop a PNG here or click to choose a sprite." Click="SpriteMenuClick">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
              <TextBlock Text="{Binding AssetLabel}" ToolTip.Tip="{Binding AssetLabel}" TextTrimming="LeadingCharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="▾"/>
            </Grid>
          </Button>
        </Grid>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Layer"/>
          <NumericUpDown Grid.Column="1" Minimum="-32768" Maximum="32767" Increment="1" Value="{Binding Layer, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Order"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-32768" Maximum="32767" Increment="1" Value="{Binding Order, Mode=TwoWay}"/>
        </Grid>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Y sort"/>
          <CheckBox Grid.Column="1" Content="Use foot Y" IsChecked="{Binding SortByY, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Foot ΔY"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-1000000" Maximum="1000000" Increment="1"
                         IsEnabled="{Binding SortByY}" Value="{Binding FootOffset, Mode=TwoWay}"
                         ToolTip.Tip="Local Y offset from the bottom center, in world units."/>
        </Grid>
        <Grid ColumnDefinitions="56,16,*" ColumnSpacing="5">
          <TextBlock Text="Color" Classes="fieldLabel"/>
          <Border Grid.Column="1" Background="{Binding ColorBrush}" CornerRadius="2"/>
          <TextBox Grid.Column="2" Text="{Binding ColorText, Mode=OneWay}" AutomationProperties.Name="Sprite tint"
                   TextChanged="SquareColorChanged" LostFocus="SquareColorCommitted" KeyDown="SquareColorKeyDown"/>
        </Grid>
        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="2">
          <TextBlock Classes="fieldLabel" Text="Flip"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <CheckBox Content="X" IsChecked="{Binding FlipX, Mode=TwoWay}" AutomationProperties.Name="Flip X"/>
            <CheckBox Content="Y" IsChecked="{Binding FlipY, Mode=TwoWay}" AutomationProperties.Name="Flip Y"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Align"/>
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Pixel snap" IsChecked="{Binding PixelSnap, Mode=TwoWay}"/>
          <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Mask"/>
          <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="SpriteMaskClick">
            <TextBlock Text="{Binding MaskLabel}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding MaskLabel}"/>
          </Button>
        </Grid>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <Window.Styles>
    <Style Selector="TreeViewItem.groupSelected"><Setter Property="Foreground" Value="{DynamicResource EditorAccent}"/></Style>
    <Style Selector="TreeViewItem.dropTarget"><Setter Property="Foreground" Value="{DynamicResource EditorAccent}"/></Style>
    <Style Selector="ToggleButton.drawerHeader:checked PathIcon"><Setter Property="RenderTransform" Value="rotate(90deg)"/></Style>
    <Style Selector="TextBlock.panel">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.panelHeader">
      <Setter Property="Height" Value="29"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="{DynamicResource EditorPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource EditorDivider}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Button.panelAction">
      <Setter Property="Width" Value="21"/><Setter Property="Height" Value="21"/>
      <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="#Inspector TextBox, #Inspector NumericUpDown, #Inspector ComboBox, #Inspector CheckBox, #Inspector Button">
      <Setter Property="MinHeight" Value="21"/>
      <Setter Property="Padding" Value="4,1"/>
    </Style>
    <Style Selector="#Inspector ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="NumericUpDown">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FormatString" Value="0.##"/>
      <Setter Property="Increment" Value="1"/>
      <Setter Property="ShowButtonSpinner" Value="False"/>
    </Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border#InspectorPanel.scriptDrop">
      <Setter Property="BoxShadow" Value="inset 0 0 0 2 #A6E9CE"/>
    </Style>
    <Style Selector="local|ComponentSection.spriteDrop">
      <Setter Property="BorderBrush" Value="#A6E9CE"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,21">
    <NativeMenuBar/>
    <Grid Grid.Row="1" ColumnDefinitions="176,*,218">
      <Border BorderBrush="{DynamicResource EditorDivider}" BorderThickness="0,0,1,0" Background="{DynamicResource EditorPanel}">
        <Grid RowDefinitions="Auto,1.25*,Auto,*">
          <Border Classes="panelHeader">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
              <TextBlock Classes="panel" Text="Hierarchy" VerticalAlignment="Center"/>
              <Button Classes="panelAction quiet" x:Name="AddButton" Grid.Column="1" Content="+" AutomationProperties.Name="Add object" ToolTip.Tip="Add square sprite" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TreeView x:Name="Hierarchy" Grid.Row="1" Margin="4,3,4,6" Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="Scene objects" ToolTip.Tip="Right-click to add an object. Drag onto a parent or onto empty space for the scene root.">
            <TreeView.Styles>
              <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="0"/>
              </Style>
              <Style Selector="TreeViewItem">
                <Setter Property="Padding" Value="3,0"/>
                <Setter Property="HeaderTemplate">
                  <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/></DataTemplate>
                </Setter>
              </Style>
            </TreeView.Styles>
          </TreeView>
          <Border Grid.Row="2" Classes="panelHeader" BorderThickness="0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
              <TextBlock Classes="panel" Text="Project" VerticalAlignment="Center"/>
              <TextBlock x:Name="ProjectName" Grid.Column="1" Margin="2,0,0,0" Classes="label" TextTrimming="LeadingCharacterEllipsis"/>
              <Button Grid.Column="2" Classes="panelAction quiet" x:Name="ParentFolderButton" Content="↑" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder"/>
              <Button Grid.Column="3" Classes="panelAction quiet" x:Name="ProjectActions" Content="+" AutomationProperties.Name="Project actions" ToolTip.Tip="Create or import" VerticalAlignment="Center">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem x:Name="ImportAssetsButton" Header="Import Assets…"/>
                    <MenuItem x:Name="ReferencesButton" Header="Asset References…"/>
                    <MenuItem x:Name="ProblemsButton" Header="Check Missing References…"/>
                    <Separator/>
                    <MenuItem x:Name="NewScriptButton" Header="New C# Script…"/>
                    <MenuItem x:Name="NewSharedButton" Header="New Shared C# File…"/>
                    <MenuItem x:Name="NewDataButton" Header="New Data Asset…"/>
                    <MenuItem x:Name="NewDialogueButton" Header="New Dialogue…"/>
                    <MenuItem x:Name="NewTableButton" Header="New Data Table…"/>
                    <MenuItem x:Name="NewTilesetButton" Header="New Tileset…"/>
                    <MenuItem x:Name="NewAtlasButton" Header="New Sprite Atlas…"/>
                    <MenuItem x:Name="NewAnimatorButton" Header="New Animator Controller…"/>
                    <MenuItem x:Name="NewClipButton" Header="New Animation Clip…"/>
                    <MenuItem x:Name="NewSceneButton" Header="New Scene"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <TextBox x:Name="AssetSearch" Margin="6,5,6,0" Watermark="Search project…" AutomationProperties.Name="Search project" ToolTip.Tip="Search all assets and scripts by path, or type (e.g. t:sprite). Esc clears."/>
            <ListBox Grid.Row="1" x:Name="ProjectBrowser" Margin="4,3" AutomationProperties.Name="Project files"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4,1"/><Setter Property="MinHeight" Value="21"/>
                  <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="14,*" ColumnSpacing="5" ToolTip.Tip="{Binding RelativePath}">
                    <PathIcon Width="12" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMuted}" IsVisible="{Binding IsFolder}"
                              Data="M1,4 L8,4 10,6 21,6 21,17 1,17 Z"/>
                    <PathIcon Width="10" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource EditorMuted}" IsVisible="{Binding !IsFolder}"
                              Data="M4,1 L13,1 19,7 19,21 4,21 Z M13,3 L13,8 17,8 Z"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock IsVisible="{Binding SearchResult}" Classes="label" FontSize="10" Text="{Binding Directory}" TextTrimming="LeadingCharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" x:Name="EmptyFolder" Classes="label" Margin="10,8" IsHitTestVisible="False" VerticalAlignment="Top" Text="Empty folder"/>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
        <Border Classes="panelHeader">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="ViewMode" Classes="label" Text="Scene"/>
            <TextBlock x:Name="SceneCaption" Grid.Column="1" Classes="panel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel x:Name="GizmoControls" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ComboBox x:Name="GizmoPicker" Width="78" Height="21" MinHeight="0" Padding="4,0" AutomationProperties.Name="Transform tool" ToolTip.Tip="Move (W), Rotate (E), Scale (R)"/>
              <CheckBox x:Name="GizmoSnap" Content="Snap" FontSize="11" ToolTip.Tip="16 units · 15° · 10%"/>
            </StackPanel>
            <StackPanel x:Name="TimeControls" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
              <ToggleButton x:Name="DebugButton" Height="21" MinHeight="0" Padding="5,0" Content="Debug" AutomationProperties.Name="Play diagnostics" ToolTip.Tip="Show runtime diagnostics below Scene"/>
              <Button x:Name="PauseButton" Focusable="False" Width="55" Height="21" MinHeight="0" Padding="3,0" Content="Pause" ToolTip.Tip="Pause or resume game time"/>
              <Button x:Name="StepButton" Focusable="False" Width="37" Height="21" MinHeight="0" Padding="3,0" Content="Step" ToolTip.Tip="Advance one fixed tick"/>
              <ComboBox x:Name="SpeedPicker" Width="68" Height="21" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center"
                        ToolTip.Tip="Game speed" AutomationProperties.Name="Game speed"/>
            </StackPanel>
            <Button x:Name="PlayButton" Classes="primary" Grid.Column="3" Width="60" Height="21" MinHeight="0" Padding="4,0"
                    Content="▶  Play" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <local:SceneViewport x:Name="Viewport" Grid.Row="1" AutomationProperties.Name="Scene viewport"
                             AutomationProperties.HelpText="Shift-click to toggle selection. W, E, R change the transform tool. Drag empty space to pan."/>
        <StackPanel Grid.Row="2" x:Name="DiagnosticsDock" IsVisible="False" Margin="8,3" Spacing="3">
          <WrapPanel x:Name="DiagnosticsTools" Orientation="Horizontal">
            <CheckBox Margin="0,0,8,0" x:Name="ColliderDebug" Content="Colliders" AutomationProperties.Name="Collider outlines"/>
            <CheckBox Margin="0,0,8,0" x:Name="QueryDebug" Content="Queries" AutomationProperties.Name="Physics queries"/>
            <Button Margin="0,0,8,0" x:Name="ProbeRay" Classes="quiet" Content="Cast ray…" AutomationProperties.Name="Cast ray from selection" ToolTip.Tip="From selected object to next click in Scene"/>
            <CheckBox Margin="0,0,8,0" x:Name="FrameDebug" Content="Profiler" AutomationProperties.Name="Frame profiler"/>
            <Button x:Name="ConsoleDebug" Classes="quiet" Content="Console…" AutomationProperties.Name="Open console"/>
          </WrapPanel>
          <TextBlock x:Name="PhysicsCaption" Classes="label" TextTrimming="CharacterEllipsis"/>
          <Grid x:Name="FramePanel" RowDefinitions="Auto,38,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
            <TextBlock x:Name="FrameSummary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="CloseProfiler" Classes="quiet" Padding="5,0" Content="×" AutomationProperties.Name="Close profiler"/>
            <local:FrameChart Grid.Row="1" Grid.ColumnSpan="2" x:Name="FrameGraph" ToolTip.Tip="Last 180 presented frames · line: frame time · guide: 16.7 ms · gold: GC"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="FrameDetail" Classes="label" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Grid>
      <Border x:Name="InspectorPanel" Grid.Column="2" BorderBrush="{DynamicResource EditorDivider}" BorderThickness="1,0,0,0" Background="{DynamicResource EditorPanel}">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="panelHeader">
            <TextBlock x:Name="InspectorTitle" Classes="panel" Text="Inspector" VerticalAlignment="Center"/>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="9,6">
              <TextBlock x:Name="EmptyInspector" Classes="label" Text="Select an object in the scene." TextWrapping="Wrap"/>
              <StackPanel x:Name="Inspector">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="5" Margin="0,0,0,4">
                  <TextBlock Text="Name" Classes="fieldLabel"/>
                  <TextBox Grid.Column="1" x:Name="ObjectName" AutomationProperties.Name="Object name"/>
                </Grid>
                <local:ComponentSection x:Name="LiveSection" Header="Runtime" HasSettings="False" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="LiveSummary" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ScriptValues" Classes="label" TextWrapping="Wrap"/>
                  </StackPanel>
                </local:ComponentSection>
                <local:ComponentSection x:Name="TransformSection" Header="Transform" HasSettings="False">
                  <StackPanel Spacing="2">
                    <Grid x:Name="PositionRow" ColumnDefinitions="56,*,*" ColumnSpacing="5">
                      <TextBlock x:Name="PositionRowLabel" Text="Position" Classes="fieldLabel"/>
                      <Grid Grid.Column="1" ColumnDefinitions="9,*" ColumnSpacing="2">
                        <TextBlock Text="X" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="PosX" AutomationProperties.Name="Position X"/>
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="9,*" ColumnSpacing="2">
                        <TextBlock Text="Y" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="PosY" AutomationProperties.Name="Position Y"/>
                      </Grid>
                    </Grid>
                    <Grid x:Name="SizeRow" ColumnDefinitions="56,*,*" ColumnSpacing="5">
                      <TextBlock Text="Size" Classes="fieldLabel"/>
                      <Grid Grid.Column="1" ColumnDefinitions="9,*" ColumnSpacing="2">
                        <TextBlock Text="W" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="ObjWidth" Minimum="1" AutomationProperties.Name="Width"/>
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="9,*" ColumnSpacing="2">
                        <TextBlock Text="H" Classes="fieldLabel"/>
                        <NumericUpDown Grid.Column="1" x:Name="ObjHeight" Minimum="1" AutomationProperties.Name="Height"/>
                      </Grid>
                    </Grid>
                    <StackPanel x:Name="AffineRows" Spacing="2">
                      <Grid ColumnDefinitions="56,*,*" ColumnSpacing="5">
                        <TextBlock Text="Rotation" Classes="fieldLabel" ToolTip.Tip="Clockwise degrees in parent space"/>
                        <NumericUpDown Grid.Column="1" Grid.ColumnSpan="2" x:Name="ObjRotation" AutomationProperties.Name="Rotation degrees"/>
                      </Grid>
                      <Grid ColumnDefinitions="56,*,*" ColumnSpacing="5">
                        <TextBlock Text="Scale" Classes="fieldLabel"/>
                        <Grid Grid.Column="1" ColumnDefinitions="9,*" ColumnSpacing="2">
                          <TextBlock Text="X" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjScaleX" Increment="0.1" AutomationProperties.Name="Scale X"/>
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="9,*" ColumnSpacing="2">
                          <TextBlock Text="Y" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjScaleY" Increment="0.1" AutomationProperties.Name="Scale Y"/>
                        </Grid>
                      </Grid>
                      <Grid ColumnDefinitions="56,*,*" ColumnSpacing="5">
                        <TextBlock Text="Pivot" Classes="fieldLabel"/>
                        <Grid Grid.Column="1" ColumnDefinitions="9,*" ColumnSpacing="2">
                          <TextBlock Text="X" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjPivotX" Increment="0.1" Minimum="0" Maximum="1" AutomationProperties.Name="Pivot X"/>
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="9,*" ColumnSpacing="2">
                          <TextBlock Text="Y" Classes="fieldLabel"/>
                          <NumericUpDown Grid.Column="1" x:Name="ObjPivotY" Increment="0.1" Minimum="0" Maximum="1" AutomationProperties.Name="Pivot Y"/>
                        </Grid>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </local:ComponentSection>
                <ItemsControl x:Name="AttachedComponents">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <local:ComponentSection Header="{Binding Name}" HasSettings="{Binding Editable}" Foldout="{Binding Foldout}">
                        <ContentControl Content="{Binding Fields}" IsEnabled="{Binding Editable}" HorizontalContentAlignment="Stretch"/>
                      </local:ComponentSection>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddComponentButton" Content="+  Add Component" AutomationProperties.Name="Add Component"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource EditorBase}" BorderBrush="{DynamicResource EditorDivider}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="Status" Classes="label" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="ResolutionLabel" Classes="label" Grid.Column="1" ToolTip.Tip="Game resolution · Project → Game Resolution…"/>
      </Grid>
    </Border>
  </Grid>
</Window>
