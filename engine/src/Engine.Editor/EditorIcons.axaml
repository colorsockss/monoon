<!-- 16×16 editor icons drawn in the repository. Every path uses the same 16-unit frame; EditorIcon keeps that frame,
     so small marks are not stretched to fill the icon. F0 paths use even-odd fill for holes. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="EditorIconSize">16</x:Double>
  <ControlTheme x:Key="EditorIcon" TargetType="PathIcon">
    <Setter Property="Width" Value="{StaticResource EditorIconSize}"/>
    <Setter Property="Height" Value="{StaticResource EditorIconSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
          <Canvas Width="16" Height="16">
            <Path Fill="{TemplateBinding Foreground}" Data="{TemplateBinding Data}"/>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Components -->
  <StreamGeometry x:Key="IconTransform">M2.25,4 H3.75 V12.25 H12 V13.75 H2.25 Z M3,1 L5.5,4.5 H0.5 Z M15,13 L11.5,15.5 V10.5 Z</StreamGeometry>
