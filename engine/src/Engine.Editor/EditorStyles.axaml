<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MoNoon/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Design tokens. Code-built windows read them through EditorTokens. -->
      <!-- Three dark levels: window base, panel, input field. -->
      <SolidColorBrush x:Key="EditorBase">#1B1D21</SolidColorBrush>
      <SolidColorBrush x:Key="EditorPanel">#222428</SolidColorBrush>
      <SolidColorBrush x:Key="EditorField">#191B1E</SolidColorBrush>
      <SolidColorBrush x:Key="EditorControl">#313439</SolidColorBrush>
      <SolidColorBrush x:Key="EditorControlHover">#3A3E44</SolidColorBrush>
      <SolidColorBrush x:Key="EditorControlPressed">#2A2D31</SolidColorBrush>
      <SolidColorBrush x:Key="EditorDivider">#383B40</SolidColorBrush>
      <SolidColorBrush x:Key="EditorBorder">#414449</SolidColorBrush>
      <SolidColorBrush x:Key="EditorBorderHover">#60666C</SolidColorBrush>
      <SolidColorBrush x:Key="EditorText">#E4E7EB</SolidColorBrush>
      <SolidColorBrush x:Key="EditorMuted">#ADB2B9</SolidColorBrush>
      <SolidColorBrush x:Key="EditorDisabled">#6F747B</SolidColorBrush>
      <!-- The accent marks selection, focus and Play state only. -->
      <SolidColorBrush x:Key="EditorAccent">#9EDAC9</SolidColorBrush>
      <SolidColorBrush x:Key="EditorAccentHover">#B0E8D9</SolidColorBrush>
      <SolidColorBrush x:Key="EditorAccentPressed">#88BCAD</SolidColorBrush>
      <SolidColorBrush x:Key="EditorOnAccent">#142920</SolidColorBrush>
      <SolidColorBrush x:Key="EditorAccentOverlay">#469EDAC9</SolidColorBrush>
      <SolidColorBrush x:Key="EditorHover">#2C3138</SolidColorBrush>
      <SolidColorBrush x:Key="EditorActive">#353E49</SolidColorBrush>
      <SolidColorBrush x:Key="EditorSelection">#354B46</SolidColorBrush>
      <SolidColorBrush x:Key="EditorSelectionHover">#405B54</SolidColorBrush>
      <SolidColorBrush x:Key="EditorDropTarget">#405551</SolidColorBrush>
      <SolidColorBrush x:Key="EditorGridLine">#A8BEC9D4</SolidColorBrush>
      <SolidColorBrush x:Key="EditorWarning">#E9C46A</SolidColorBrush>
      <SolidColorBrush x:Key="EditorError">#F2877A</SolidColorBrush>

      <!-- Type scale: base 12, panel titles and tabs 12 SemiBold, secondary 11 muted. -->
      <x:Double x:Key="EditorFontSize">12</x:Double>
      <x:Double x:Key="EditorFontSizeSmall">11</x:Double>
      <FontWeight x:Key="EditorTitleWeight">SemiBold</FontWeight>

      <!-- Spacing on a 4px grid. -->
      <x:Double x:Key="EditorGap">4</x:Double>
      <x:Double x:Key="EditorGap2">8</x:Double>
      <x:Double x:Key="EditorRowHeight">22</x:Double>
      <x:Double x:Key="EditorInputHeight">24</x:Double>
      <x:Double x:Key="EditorPanelHeaderHeight">28</x:Double>
      <Thickness x:Key="EditorPanelPadding">8</Thickness>
      <Thickness x:Key="EditorPanelHeaderPadding">8,0</Thickness>
      <Thickness x:Key="EditorPanelHeaderBarPadding">8,0,8,1</Thickness>
      <Thickness x:Key="EditorWindowPadding">12</Thickness>
      <Thickness x:Key="EditorControlPadding">8,2</Thickness>
      <Thickness x:Key="EditorInputPadding">6,2</Thickness>
      <Thickness x:Key="EditorBorderThickness">1</Thickness>
      <CornerRadius x:Key="EditorCornerRadius">3</CornerRadius>
      <!-- Inspector rows keep the existing fixed label column; only the field column grows. -->
      <x:Double x:Key="EditorFieldLabelWidth">56</x:Double>
      <x:Double x:Key="EditorFieldGap">4</x:Double>
      <x:Double x:Key="EditorDialogLabelWidth">80</x:Double>

      <!-- Fluent theme resources mapped to the tokens: one hover, pressed, selected, focus and disabled rule per control. -->
      <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
      <x:Double x:Key="TreeViewItemMinHeight">22</x:Double>
      <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
      <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
      <x:Double x:Key="CheckBoxMinHeight">24</x:Double>
      <x:Double x:Key="TabItemHeaderFontSize">12</x:Double>
      <x:Double x:Key="TabItemMinHeight">28</x:Double>
      <FontWeight x:Key="TabItemHeaderThemeFontWeight">SemiBold</FontWeight>
      <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="EditorAccent"/>
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent"/>

      <StaticResource x:Key="ButtonBackground" ResourceKey="EditorControl"/>
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EditorControlHover"/>
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EditorControlPressed"/>
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="ButtonForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="EditorBorderHover"/>
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="EditorDivider"/>

      <StaticResource x:Key="ToggleButtonBackground" ResourceKey="EditorControl"/>
      <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="EditorControlHover"/>
      <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="EditorControlPressed"/>
      <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="EditorSelectionHover"/>
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="ToggleButtonForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="EditorBorderHover"/>
      <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="EditorAccent"/>
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="EditorAccentHover"/>
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="EditorAccent"/>
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="EditorDivider"/>

      <StaticResource x:Key="TextControlBackground" ResourceKey="EditorField"/>
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="EditorField"/>
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="EditorField"/>
      <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="TextControlForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="EditorText"/>
      <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="EditorBorderHover"/>
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="EditorAccent"/>
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="EditorSelectionHover"/>

      <StaticResource x:Key="ComboBoxBackground" ResourceKey="EditorControl"/>
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="EditorControlHover"/>
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="EditorControlPressed"/>
      <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="EditorControl"/>
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="EditorAccent"/>
      <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="EditorBorderHover"/>
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="EditorHover"/>
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="EditorActive"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="EditorSelectionHover"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="EditorDisabled"/>

      <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="EditorField"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="EditorField"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="EditorControlPressed"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="EditorBorderHover"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="EditorAccent"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="EditorAccentHover"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="EditorAccentPressed"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="EditorAccentHover"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="EditorAccentPressed"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" ResourceKey="EditorDivider"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="EditorOnAccent"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="EditorOnAccent"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="EditorOnAccent"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="EditorDisabled"/>

      <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="EditorHover"/>
      <StaticResource x:Key="TreeViewItemBackgroundPressed" ResourceKey="EditorActive"/>
      <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="EditorSelectionHover"/>
      <StaticResource x:Key="TreeViewItemBackgroundSelectedPressed" ResourceKey="EditorSelection"/>
      <StaticResource x:Key="TreeViewItemBackgroundSelectedDisabled" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="TreeViewItemForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundSelectedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundSelectedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="TreeViewItemForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="TreeViewItemForegroundSelectedDisabled" ResourceKey="EditorDisabled"/>

      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="EditorBorder"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="EditorHover"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="EditorActive"/>
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="EditorText"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="EditorMuted"/>

      <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent"/>
      <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="EditorHover"/>
      <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPressed" ResourceKey="EditorActive"/>
      <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="EditorPanel"/>
      <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="EditorPanel"/>
      <SolidColorBrush x:Key="TabItemHeaderBackgroundDisabled" Color="Transparent"/>
      <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="EditorMuted"/>
      <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="TabItemHeaderForegroundUnselectedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="EditorText"/>
      <StaticResource x:Key="TabItemHeaderForegroundSelectedPointerOver" ResourceKey="EditorText"/>
      <StaticResource x:Key="TabItemHeaderForegroundSelectedPressed" ResourceKey="EditorText"/>
      <StaticResource x:Key="TabItemHeaderForegroundDisabled" ResourceKey="EditorDisabled"/>
      <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="EditorAccent"/>

      <DataTemplate x:Key="SheetPathTemplate">
        <TextBlock Text="{Binding Path}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
      </DataTemplate>
      <ControlTheme x:Key="SheetGridToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="MaxWidth" Value="148"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ToolTip.Tip" Value="Show or hide cell size, margin and spacing (pixels)"/>
        <Setter Property="ContentTemplate">
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <PathIcon Classes="sheetDisclosure" Grid.Column="1" Width="7" Height="7" Data="M1,0 L7,4 L1,8 Z"/>
            </Grid>
          </DataTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="ToggleButton:checked PathIcon.sheetDisclosure"><Setter Property="RenderTransform" Value="rotate(90deg)"/></Style>
  <Style Selector="NumericUpDown.sheetNumber">
    <Setter Property="ShowButtonSpinner" Value="False"/>
    <Setter Property="FormatString" Value="0"/>
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource EditorBase}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorText}"/>
  </Style>
  <Style Selector="Window, Button, ToggleButton, TextBox, NumericUpDown, ComboBox, ComboBoxItem, CheckBox, TreeViewItem, ListBoxItem, MenuItem, TabItem">
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}"/>
  </Style>
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="{StaticResource EditorInputHeight}"/>
    <Setter Property="Padding" Value="{StaticResource EditorControlPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource EditorCornerRadius}"/>
    <Setter Property="BorderThickness" Value="{StaticResource EditorBorderThickness}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox, NumericUpDown, ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource EditorInputHeight}"/>
    <Setter Property="Padding" Value="{StaticResource EditorInputPadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource EditorCornerRadius}"/>
  </Style>
  <Style Selector="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorHover}"/>
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorActive}"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorSelection}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorText}"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorSelectionHover}"/>
  </Style>
  <Style Selector="ListBoxItem:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabled}"/></Style>
  <Style Selector="TabItem">
    <Setter Property="FontWeight" Value="{StaticResource EditorTitleWeight}"/>
    <Setter Property="Padding" Value="{StaticResource EditorPanelHeaderPadding}"/>
  </Style>
  <!-- Drag targets tint the row or outline the panel; neither changes layout. -->
  <Style Selector="TreeViewItem.dropTarget, ListBoxItem.dropTarget"><Setter Property="Foreground" Value="{DynamicResource EditorAccent}"/></Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}"/>
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorHover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorText}"/>
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="{DynamicResource EditorField}"/></Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource EditorAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorOnAccent}"/>
    <Setter Property="FontWeight" Value="{StaticResource EditorTitleWeight}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorAccentHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorOnAccent}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource EditorAccentPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorOnAccent}"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{StaticResource EditorInputHeight}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}"/>
    <Setter Property="FontSize" Value="{StaticResource EditorFontSizeSmall}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Fixed label columns: a label wider than its column (another OS font) trims and still names itself in a tooltip. -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}"/>
    <Setter Property="FontWeight" Value="{StaticResource EditorTitleWeight}"/>
  </Style>
  <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource EditorWarning}"/></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource EditorError}"/></Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource EditorDivider}"/>
  </Style>
</Styles>
