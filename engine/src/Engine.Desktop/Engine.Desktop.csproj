<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Engine.Authoring"/>
    <InternalsVisibleTo Include="Engine.Checks"/>
    <ProjectReference Include="../Engine.Core/Engine.Core.csproj" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl" Version="2026.10.3" GeneratePathProperty="true" />
    <!-- Game text (FreeType, HarfBuzz, zlib inside SDL3_ttf); its notices ship with the BRUTAL ones. -->
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Ttf" Version="2026.10.3" GeneratePathProperty="true" />
    <None Include="$(PkgAhwoo_BRUTAL_Sdl)/LICENSE.txt;$(PkgAhwoo_BRUTAL_Sdl)/NOTICE.txt;$(PkgAhwoo_BRUTAL_Sdl)/CONTRIBUTORS.md"
          Link="Licenses/BRUTAL/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgAhwoo_BRUTAL_Sdl)/LICENSES/**/*;$(PkgAhwoo_BRUTAL_Sdl_Ttf)/LICENSES/**/*" Link="Licenses/BRUTAL/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../native/windows-x64/LICENSE.txt" Link="Licenses/SDL/LICENSE.txt" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == ''" />
  </ItemGroup>
</Project>
